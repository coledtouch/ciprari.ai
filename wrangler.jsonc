// Deploys the built changelog-site folder to the "changelog" Worker (changelog.ciprari.ai).
// Used by GitHub Actions after build_blog.py generates the site.
{
  "name": "changelog",
  "compatibility_date": "2026-08-12",
  "assets": {
    "directory": "./changelog-site"
  },
  // changelog.ciprari.ai is the only address: no changelog.coleciprari.workers.dev
  // duplicate and no per-version preview URLs. Wrangler defaults both to on, so these
  // keep every deploy from switching them back. With no routes listed, wrangler leaves
  // the changelog.ciprari.ai custom domain alone.
  "workers_dev": false,
  "preview_urls": false
}
